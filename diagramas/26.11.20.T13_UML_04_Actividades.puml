@startuml
' =============================================
' DIAGRAMA DE ACTIVIDADES - BATD
' =============================================
skinparam style strictuml
skinparam RoundCorner 15
skinparam defaultFontName "Arial"
skinparam backgroundColor white
skinparam Shadowing true
skinparam dpi 300
skinparam ArrowThickness 1.5
skinparam defaultFontStyle bold
skinparam noteFontStyle bold
skinparam ArrowColor darkgreen

skinparam activity {
    BackgroundColor #85C1E9
    BorderColor black
    FontColor black
    FontStyle bold
    FontSize 13
}

skinparam activityDiamond {
    BackgroundColor #F7DC6F
    BorderColor #5D6D7E
    FontColor black
    FontStyle bold
}

skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor black
skinparam noteFontColor #000000

skinparam partition {
    BackgroundColor #FBFCFC
    BorderColor #5D6D7E
    FontColor black
    FontStyle bold
}

title Diagrama de Actividades — Del Precio a la Recomendación Semanal

start
:Cargar la foto de datos (4 CSV) o descargar de Yahoo Finance;
:Construir variables causales y objetivos binarios;
:Partir cronológicamente con embargo;
partition "Modelado" {
    :Ajustar logística, Naive Bayes, SVM y ensambles con validación cronológica;
    if (¿el evento es raro?) then (sí)
        :Rebalancear con pesos o SMOTE dentro del pipeline;
    endif
}
partition "Evaluación" {
    :Medir AUC-ROC, AUC-PR y Brier frente a la tasa base;
    :Elegir el umbral por costos en validación;
    if (¿el AUC se distingue de la prueba de permutación?) then (sí)
        :Declarar señal y reportar su ventaja;
    else (no)
        :Declarar que es indistinguible del azar;
    endif
}
partition "Sistema" {
    :Validar con walk-forward y costos de 10 pb;
    :Comparar con 1/N, SPY y carteras al azar;
    :Traducir probabilidades en COMPRAR, MANTENER o EVITAR;
}
:Exportar el JSON y mostrarlo en el tablero con la advertencia legal;
stop

@enduml

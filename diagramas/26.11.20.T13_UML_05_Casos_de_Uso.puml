@startuml
' =============================================
' DIAGRAMA DE CASOS DE USO - BATD
' =============================================
skinparam style strictuml
skinparam RoundCorner 15
skinparam defaultFontName "Arial"
skinparam backgroundColor white
skinparam Shadowing true
skinparam dpi 300
skinparam ArrowThickness 1.5
skinparam defaultFontStyle bold
skinparam noteFontStyle bold
skinparam ArrowColor darkgreen

skinparam actor {
    BackgroundColor #85C1E9
    BorderColor black
    FontColor black
    FontStyle bold
    FontSize 14
}

skinparam usecase {
    BackgroundColor #85C1E9
    BorderColor black
    FontColor black
    FontStyle bold
    FontSize 12
}

skinparam rectangle {
    BackgroundColor #FBFCFC
    BorderColor #5D6D7E
    FontColor black
    FontStyle bold
    FontSize 14
    RoundCorner 10
}

skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor black
skinparam noteFontColor #000000

title Diagrama de Casos de Uso del Laboratorio de Clasificación Bursátil (Tema 13)

left to right direction

actor "Estudiante" as EST
actor "Docente" as DOC
actor "Gestor de portafolio" as GES
actor "Yahoo Finance" as YF

rectangle "Laboratorio de Clasificación Bursátil (Tema 13)" {
    usecase "CU01 Calcular métricas desde la matriz de confusión" as CU01
    usecase "CU02 Comparar Naive Bayes y SVM" as CU02
    usecase "CU03 Comparar ensambles de árboles" as CU03
    usecase "CU04 Alertar una caída extrema" as CU04
    usecase "CU05 Anticipar el régimen de volatilidad" as CU05
    usecase "CU06 Generar recomendaciones semanales" as CU06
    usecase "CU07 Consultar el tablero" as CU07
    usecase "CU08 Revisar el trabajo grupal" as CU08

    usecase "Descargar y validar los precios" as INC1
    usecase "Partir cronológicamente con embargo" as INC2
    usecase "Comparar con la referencia ingenua" as INC3
    usecase "Rebalancear con SMOTE dentro del pipeline" as EXT1
    usecase "Ajustar el umbral por costos" as EXT2
}

EST --> CU01
EST --> CU02
EST --> CU03
EST --> CU04
EST --> CU05
EST --> CU06
GES --> CU07
DOC --> CU08
YF --> INC1

CU02 ..> INC2 : <<include>>
CU03 ..> INC2 : <<include>>
CU04 ..> INC2 : <<include>>
CU05 ..> INC2 : <<include>>
CU06 ..> INC2 : <<include>>
CU02 ..> INC3 : <<include>>
CU06 ..> INC3 : <<include>>
CU02 ..> INC1 : <<include>>
CU06 ..> INC1 : <<include>>
EXT1 .up.> CU04 : <<extend>>
EXT2 .up.> CU04 : <<extend>>
EXT2 .up.> CU05 : <<extend>>
CU07 ..> CU06 : <<include>>

@enduml
